# ---------------------------------------------------------------------------
# Copy this file to .env and adjust. .env is gitignored — never commit it.
#
#     cp .env.example .env
#
# Real environment variables always win over this file, so production sets them
# directly and ships no .env at all.
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
# Leave DEBUG=1 for local development. With DEBUG=0 the app refuses to start
# without a real DJANGO_SECRET_KEY, and switches on HTTPS/secure-cookie settings.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
DJANGO_REQUEST_LOG_LEVEL=WARNING
APP_LOG_LEVEL=DEBUG
DJANGO_CACHE_DEFAULT_TIMEOUT=300
DJANGO_CACHE_MAX_ENTRIES=1000
DASHBOARD_CACHE_SECONDS=30

# Session lifetime in seconds (default 12 hours).
DJANGO_SESSION_AGE=43200

# --- PostgreSQL -----------------------------------------------------------
# Each team member runs their own local database. Migrations are shared through
# git; the data is not.
# For Supabase on an IPv4 network, use the Session pooler values shown by the
# dashboard's Connect button (port 5432 and a user like postgres.<project-ref>).
# URL-encode special characters in the password before placing it in this URL.
DATABASE_URL=

# Persistent Django workers should use the Supabase session pooler (5432).
# These settings reuse healthy connections and fail quickly when the database
# is unavailable instead of leaving a page hanging indefinitely.
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=0
DB_CONNECT_TIMEOUT=10
DB_APPLICATION_NAME=ledgerwise-django

# Optional isolated database name for local/CI test runs. Leave blank to use
# Django's standard test_<database-name> convention.
DJANGO_TEST_DATABASE_NAME=

# Alternatively, configure PostgreSQL with individual values:
PGDATABASE=wams
PGUSER=postgres
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
# Supabase and other hosted PostgreSQL providers should use `require`.
PGSSLMODE=prefer

# --- Email ---------------------------------------------------------------
# Password reset sends a signed single-use link, so it needs a way to send mail.
# Leave DJANGO_EMAIL_HOST empty in development and the message is printed to the
# console, where the link can be clicked from the server log.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_FROM_EMAIL=no-reply@ledgerwise.local
# Reset links expire after this many seconds (default 3 hours).
DJANGO_PASSWORD_RESET_TIMEOUT=10800

# --- Production HTTPS ----------------------------------------------------
# Enable only when the deployment proxy reliably replaces this header.
DJANGO_BEHIND_HTTPS_PROXY=0
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
# Turn on only after HTTPS has been proven for every subdomain.
DJANGO_HSTS_PRELOAD=0

# --- Stripe (PAY-013) -----------------------------------------------------
# Leave STRIPE_SECRET_KEY empty and the whole integration stays off: the Charge
# button does not appear and the webhook rejects everything. Payments can still
# be recorded by hand with the STRIPE payment method.
#
# Use the test keys (sk_test_...) for development. Never commit a live key.
STRIPE_SECRET_KEY=
# From `stripe listen` in development, or the endpoint's signing secret in the
# Stripe dashboard. Without it the webhook refuses every request, because the
# signature is the only thing proving a callback came from Stripe.
STRIPE_WEBHOOK_SECRET=
# Absolute public origin Stripe sends the customer back to. No trailing slash.
STRIPE_RETURN_ORIGIN=http://127.0.0.1:8000
# How long a payment link stays payable. Stripe allows 30 to 1440 minutes.
STRIPE_SESSION_MINUTES=720

# How long an idle connection may sit before the kernel probes it, and how
# many probes it takes to declare it dead. Defaults detect a vanished peer in
# roughly a minute; connect_timeout does not cover this case.
DB_KEEPALIVES_IDLE=30
DB_KEEPALIVES_INTERVAL=10
DB_KEEPALIVES_COUNT=3
